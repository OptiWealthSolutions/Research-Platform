{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "/opt/anaconda3/bin/python3",
      "runtimeArgs": ["-m", "http.server", "3001", "--bind", "127.0.0.1", "--directory", "frontend"],
      "port": 3001
    },
    {
      "name": "backend",
      "runtimeExecutable": "/opt/anaconda3/bin/python3",
      "runtimeArgs": ["-m", "uvicorn", "backend.main:app", "--host", "127.0.0.1", "--port", "8001"],
      "port": 8001
    }
  ]
}
